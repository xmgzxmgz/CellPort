<Window x:Class="CellPort.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Style="{StaticResource BodyText}"
                   TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Margin="0,12,0,0"
                 Style="{StaticResource InputBox}"
                 KeyDown="Input_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="取消" Width="76" Height="30"
                    Style="{StaticResource GhostButton}"
                    Click="Cancel_Click" />
            <Button Content="确定" Width="76" Height="30" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
