<Window x:Class="CellPort.App.Dialogs.WinUsbBinderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="驱动绑定向导"
        Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="为模块绑定 WinUSB 驱动"
                       Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="本程序通过 Windows 自带的 WinUSB 驱动访问模块的 AT 接口（MI_02），无需安装 Quectel 官方驱动包。首次使用需完成以下绑定。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,16,0,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="步骤 1 · 确认设备已插入" Style="{StaticResource HeadingText}" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="将大疆 4G 模块接入电脑。在设备管理器中应能看到「其他设备」下多个 EG25D-QDC507 条目（带黄色感叹号），这是正常的。" />
                        <Button Content="打开设备管理器" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Height="30"
                                Style="{StaticResource GhostButton}"
                                Click="OpenDevMgr_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="步骤 2 · 找到 MI_02 接口" Style="{StaticResource HeadingText}" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="在那些 EG25D-QDC507 设备中，逐个右键 → 属性 → 详细信息 → 属性选「硬件 ID」。找到硬件 ID 中包含 &amp;MI_02 的那一个（若找不到，MI_03 亦可）。" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="参考格式：USB\VID_2CA3&amp;PID_4006&amp;MI_02" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="步骤 3 · 手动指定驱动" Style="{StaticResource HeadingText}" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="右键该 MI_02 设备 → 更新驱动程序 → 浏览我的电脑以查找驱动程序 → 让我从计算机上的可用驱动程序列表中选取 → 选择「通用串行总线设备」→ 厂商选 Microsoft → 型号选「WinUsb 设备」→ 下一步 → 确认安装。" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="WinUSB 驱动由 Windows 内置且已签名，不需要禁用驱动签名强制。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="步骤 4 · 返回并连接" Style="{StaticResource HeadingText}" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="绑定完成后，MI_02 应出现在「通用串行总线设备」下。回到主界面点击「连接模块」即可。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="备选方案：安装 Quectel 官方驱动" Style="{StaticResource HeadingText}" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="若不便手动绑定，也可安装 Quectel 官方 Windows USB 驱动包，把 MI_02 绑定为「Quectel USB AT Port」生成 COM 口。本程序同样支持串口通道，会自动探测使用。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="只读检测设备" Height="34"
                    Style="{StaticResource GhostButton}"
                    Click="Diagnose_Click" />
            <Button Content="我知道了" Margin="8,0,0,0" Height="34"
                    Style="{StaticResource PrimaryButton}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
