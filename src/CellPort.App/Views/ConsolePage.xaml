<UserControl x:Class="CellPort.App.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 输出 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="OutputScroller" VerticalScrollBarVisibility="Auto"
                          Padding="14,12">
                <TextBlock x:Name="OutputText"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- 命令历史快捷键 -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,8" x:Name="QuickPanel" />

        <!-- 输入 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="AT"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource TextDimBrush}" />

            <TextBox x:Name="CommandBox" Grid.Column="1"
                     Style="{StaticResource InputBox}"
                     FontFamily="{StaticResource MonoFont}"
                     KeyDown="Command_KeyDown" />

            <Button x:Name="RunButton" Grid.Column="2" Content="执行"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="Run_Click" />
        </Grid>
    </Grid>
</UserControl>
