<UserControl x:Class="CellPort.App.Views.SmsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="22,18,22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：会话列表 ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,12" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <TextBlock Text="会话" Style="{StaticResource HeadingText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ExportCsvButton" Content="导出 CSV"
                                    Height="28" Padding="10,0"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="把当前全部短信导出为 CSV（Excel 可直接打开）"
                                    Click="ExportCsv_Click" />
                            <Button x:Name="ExportJsonButton" Content="导出 JSON"
                                    Height="28" Padding="10,0" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="把当前全部短信导出为 JSON"
                                    Click="ExportJson_Click" />
                            <Button x:Name="NewSmsButton" Content="新短信"
                                    Height="28" Padding="10,0" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Click="NewSms_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="ThreadList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="Thread_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="14,10"
                                                Background="Transparent"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource CardHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== 右：对话详情 ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 会话头 -->
                <Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DetailNumber" Text="选择一条会话"
                                       Style="{StaticResource HeadingText}" />
                            <TextBlock x:Name="DetailMeta" Text=""
                                       Style="{StaticResource DimText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="CallButton" Content="拨打"
                                HorizontalAlignment="Right" Height="28"
                                Padding="12,0"
                                Style="{StaticResource GhostButton}"
                                Click="Call_Click" />
                    </Grid>
                </Border>

                <!-- 消息列表 -->
                <ScrollViewer Grid.Row="1" x:Name="MessageScroller"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16,12">
                    <StackPanel x:Name="MessagePanel" />
                </ScrollViewer>

                <!-- 发送区 -->
                <Border Grid.Row="2" Padding="14,12" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NumberBox" Grid.Column="0" Width="130"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,8,0"
                                 ToolTip="目标号码" />

                        <TextBox x:Name="BodyBox" Grid.Column="1"
                                 Style="{StaticResource InputBox}"
                                 KeyDown="Body_KeyDown"
                                 ToolTip="短信内容（Ctrl+Enter 发送）" />

                        <Button x:Name="SendButton" Grid.Column="2" Content="发送"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="Send_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
