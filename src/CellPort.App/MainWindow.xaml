<Window x:Class="CellPort.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CellPort · 4G 模块管理器"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Row="0" Margin="18,20,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="4G" Foreground="White" FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CellPort" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="BrandSubtitle" Text="QDC507 管理器"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextDimBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 导航项 -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavSms" Style="{StaticResource NavButton}"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked"
                                 Tag="Sms">
                        <TextBlock Text="短信" />
                    </RadioButton>
                    <RadioButton x:Name="NavCalls" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Calls">
                        <TextBlock Text="通话" />
                    </RadioButton>
                    <RadioButton x:Name="NavDevice" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Device">
                        <TextBlock Text="设备" />
                    </RadioButton>
                    <RadioButton x:Name="NavEsim" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Esim">
                        <TextBlock Text="eSIM" />
                    </RadioButton>
                    <RadioButton x:Name="NavConsole" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Console">
                        <TextBlock Text="AT 控制台" />
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Settings">
                        <TextBlock Text="设置" />
                    </RadioButton>
                </StackPanel>

                <!-- 底部连接状态 -->
                <Border Grid.Row="2" Margin="12,0,12,14" Padding="12,10"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8"
                                     Fill="{DynamicResource DangerBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnText" Text="未连接"
                                       Margin="8,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="StatusHint"
                                   Margin="0,8,0,0"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   LineHeight="15"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Text="点击下方按钮连接模块。" />
                        <Button x:Name="ConnectButton" Content="连接模块"
                                Margin="0,10,0,0" Height="30"
                                Style="{StaticResource PrimaryButton}"
                                Click="Connect_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 右侧内容 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部状态条 -->
            <Border Grid.Row="0" Padding="22,16" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PageTitle" Text="短信"
                                   Style="{StaticResource TitleText}" />
                        <TextBlock x:Name="PageSubtitle" Text="未连接模块"
                                   Style="{StaticResource DimText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Padding="10,6" CornerRadius="7"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="信号" Style="{StaticResource DimText}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SignalText" Text="--"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="7"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="运营商" Style="{StaticResource DimText}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="OperatorText" Text="--"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 页面容器 -->
            <ContentControl Grid.Row="1" x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
